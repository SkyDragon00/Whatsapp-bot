/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudflare-worker",
	"main": "src/index.js",
	"compatibility_date": "2026-07-14",
	"vars": {
		"ADMIN_ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000",
		"GEMINI_DIAGNOSTICS": "true",
		"BUSINESS_CURRENCY": "USD",
		"EXPENSE_CATEGORIES": "Insumos,Servicios,Transporte,Alimentación,Marketing,Mantenimiento,Otros"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "appointments-db",
			"database_id": "9fcd9ecd-8cc3-4e26-ac00-080ca43bc53a",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CONVERSATIONS",
			"id": "2c9d6a56fd5648889176166b1f34346c"
		}
	],
	"r2_buckets": [
		{
			"binding": "RECEIPTS",
			"bucket_name": "whatsapp-bot-receipts",
			"preview_bucket_name": "whatsapp-bot-receipts-preview"
		},
		{
			"bucket_name": "whatsapp-bot-receipts",
			"binding": "whatsapp_bot_receipts",
			"remote": true
		},
		{
			"bucket_name": "whatsapp-bot-receipts-preview",
			"binding": "whatsapp_bot_receipts_preview",
			"remote": true
		}
	],
	"assets": {
		"directory": "../public",
		"binding": "ASSETS"
	}
	/**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
	// "placement": { "mode": "smart" }
	/**
   * Environment Variables
   */
	// "vars": { "MY_VARIABLE": "production_value" }
	/**
   * Static Assets
   */
	/**
   * Service Bindings
   */
	// "services": [
	//   {
	//     "binding": "MY_SERVICE",
	//     "service": "my-service"
	//   }
	// ]
}